---
import WorkItem from './WorkItem.astro';
import { translations, type Locale } from '../i18n';
const { locale = 'en' } = Astro.props as { locale?: Locale };
const t = translations[locale];
---
<section id="work" class="max-w-7xl mx-auto w-11/12">
  <div class="mb-12">
    <p class="text-sm uppercase tracking-widest mb-4 opacity-70">{t.selected}</p>
    <h2 class="text-4xl md:text-7xl">{t.featured}</h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <WorkItem img="/capocoot.webp" alt={t.alts[0]} title="CAPOCOOT" href="https://capocoot.com/" category={t.categories[0]} locale={locale}>
      <p>{t.capocoot}</p>
      <p class="mt-3">Astro · Tailwind CSS · JavaScript</p>
    </WorkItem>
    <WorkItem img="/promotora-roiz.png" alt={t.alts[1]} title="Torre Roiz" href="https://privaterealestate.netlify.app/" category={t.categories[1]} locale={locale}>
      <p>{t.torre}</p>
      <p class="mt-3">Next.js 15 · React 19 · TypeScript · Tailwind CSS 4 · Radix UI</p>
    </WorkItem>
    <WorkItem img="/logo-daily-power-1.webp" alt={t.alts[2]} title="Daily Power" href="https://www.dailypower.com.do/" category={t.categories[2]} locale={locale}>
      <p>Next.js · Node.js · JavaScript · Tailwind CSS · Contentful CMS · REST APIs</p>
    </WorkItem>
    <WorkItem img="/UnivWindowslogo.png" alt={t.alts[3]} title="Universal Windows and Doors" href="https://universalwindowsanddoors.netlify.app/" category={t.categories[3]} locale={locale}>
      <p>Astro · JavaScript · Tailwind CSS · HTML · CSS</p>
    </WorkItem>
  </div>
</section>

