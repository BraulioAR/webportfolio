---
import { translations, type Locale } from "../i18n";
interface Props { locale?: Locale; img: string; alt: string; title: string; href: string; category?: string; }
const { img, alt, title, href, category = '', locale = 'en' } = Astro.props;
const t = translations[locale];
---
<article class="project-card">
  <a class="project-image" href={href} target="_blank" rel="noopener noreferrer" aria-label={`${t.visit}: ${title} (${t.newtab})`}>
    <img src={img} alt={alt} loading="lazy" decoding="async" width="800" height="450" />
  </a>
  <div class="project-details">
    <p class="project-category">{category}</p>
    <h3>{title}</h3>
    <div class="project-description"><slot /></div>
    <a class="project-link" href={href} target="_blank" rel="noopener noreferrer">{t.visit} <span aria-hidden="true">↗</span><span class="sr-only"> ({t.newtab})</span></a>
  </div>
</article>
<style>
.project-card { border: 1px solid color-mix(in srgb, var(--color-text) 22%, transparent); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; }
.project-image { display: flex; align-items: center; justify-content: center; background: #f4f4ef; aspect-ratio: 16 / 9; overflow: hidden; }
.project-image img { width: 100%; height: 100%; object-fit: contain; padding: 24px; transition: transform .3s ease; }
.project-image:hover img { transform: scale(1.04); }
.project-details { padding: 28px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
.project-category { font-size: 12px; text-transform: uppercase; letter-spacing: .12em; opacity: .7; }
h3 { font-size: clamp(21px, 3vw, 28px); line-height: 1.25; }
.project-description { font-size: 14px; line-height: 1.8; opacity: .85; }
.project-link { margin-top: auto; padding-top: 12px; font-size: 14px; font-weight: 600; text-decoration: underline; text-underline-offset: 6px; display: flex; justify-content: space-between; gap: 16px; }
a:focus-visible { outline: 3px solid #b88532; outline-offset: -3px; }
@media (prefers-reduced-motion: reduce) { .project-image img { transition: none; } }
</style>
