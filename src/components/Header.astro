---
import { translations, localePath, cvPath, type Locale } from '../i18n';
const { locale = 'en' } = Astro.props as { locale?: Locale };
const t = translations[locale];
const languages = [{code:'en',label:'English'}, {code:'es',label:'Español'}, {code:'pt',label:'Português'}] as const;
---
<header class="site-header mx-auto max-w-7xl w-11/12">
  <a href={localePath(locale)} class="brand">Braulio Rosario</a>
  <nav aria-label={t.nav} class="header-nav">
    <a href="#work">{t.work}</a>
    <a href={cvPath(locale)} download>{t.cv}</a>
    <button id="toggleColorScheme" type="button" aria-pressed="false">{t.theme}</button>
  </nav>
  <nav class="language-switcher" aria-label={t.language}>
    {languages.map(({code,label}) => <a href={localePath(code)} lang={code} hreflang={code} aria-label={label} title={label} aria-current={locale === code ? 'page' : undefined}>{code.toUpperCase()}</a>)}
  </nav>
</header>
<script>
  const button = document.getElementById('toggleColorScheme');
  button?.addEventListener('click', () => {
    const light = document.body.classList.contains('dark-mode');
    document.body.classList.toggle('light-mode', light);
    document.body.classList.toggle('dark-mode', !light);
    button.setAttribute('aria-pressed', String(light));
  });
</script>
<style>
.site-header { display:flex; align-items:center; flex-wrap:wrap; gap:20px 28px; padding-top:24px; padding-bottom:96px; }
.brand { margin-right:auto; }
.header-nav { display:flex; align-items:center; flex-wrap:wrap; gap:24px; font-size:14px; }
.header-nav button { border:1px solid currentColor; padding:6px 10px; border-radius:6px; font-size:12px; }
.language-switcher { display:flex; border:1px solid color-mix(in srgb, var(--color-text) 35%, transparent); border-radius:999px; padding:4px; gap:2px; }
.language-switcher a { font-size:12px; padding:6px 9px; border-radius:999px; }
.language-switcher a[aria-current] { background:var(--color-text); color:var(--color-background); }
a:focus-visible,button:focus-visible { outline:2px solid #b88532; outline-offset:4px; }
@media(max-width:600px) { .site-header { gap:18px 10px; padding-bottom:64px; } .brand { font-size:14px; } .header-nav { order:3; width:100%; justify-content:space-between; gap:12px; } }
</style>
